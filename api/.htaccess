# API GREC : tout passe par index.php ; les fichiers internes ne sont jamais servis.
Options -Indexes
RewriteEngine On
RewriteRule ^(lib|tests)(/|$) - [F,L]
RewriteRule ^(config\.php|config\.sample\.php|schema\.sql|mail\.log)$ - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
</IfModule>
