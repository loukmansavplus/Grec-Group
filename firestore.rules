rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin = document admins/{uid} actif.
    // Le premier admin se crée À LA MAIN dans la console Firebase
    // (voir ADMIN-SETUP.md) : aucune adresse email n'est codée ici.
    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;
    }

    function isOwner(data) {
      return isAuthenticated() && data.authorUid == request.auth.uid;
    }

    // ── Membres ─────────────────────────────────────────────
    // Lecture réservée aux connectés (le document contient email/téléphone).
    // Chacun gère son profil mais ne peut pas se donner un rôle ou un statut.
    match /membres/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == 'membre'
        && request.resource.data.statut == 'actif';
      allow update: if isAdmin() || (
        isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.statut == resource.data.statut
      );
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // ── Admins ──────────────────────────────────────────────
    match /admins/{adminId} {
      allow get: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Journal des actions admin
    match /ACTION_LOG/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ── Actualités et événements ────────────────────────────
    // Les brouillons / contenus en attente ne sont lisibles que par
    // l'admin et leur auteur. Les requêtes publiques doivent filtrer
    // sur publie == true.
    match /actualites/{articleId} {
      allow read: if resource.data.publie == true || isAdmin() || isOwner(resource.data);
      allow write: if isAdmin();
    }

    match /evenements/{eventId} {
      allow read: if resource.data.publie == true || isAdmin() || isOwner(resource.data);
      allow write: if isAdmin();
    }

    // ── Contributions des membres (modérées par l'admin) ────
    match /contributions/{contribId} {
      allow read: if isAdmin() || isOwner(resource.data);
      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.validationStatus == 'en_attente'
        && request.resource.data.publie == false
        && request.resource.data.type in ['article', 'event'];
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isOwner(resource.data) && resource.data.validationStatus == 'en_attente');
    }

    // ── Galerie et partenaires : lecture publique, écriture admin ──
    match /galerie/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partenaires/{partnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Newsletter : inscription publique validée, lecture admin ──
    match /newsletter/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'subscribedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      allow read, update, delete: if isAdmin();
    }

    // ── Contacts : message public validé, lecture admin ─────
    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasOnly(['nom', 'email', 'message', 'createdAt', 'source'])
        && request.resource.data.nom is string && request.resource.data.nom.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.message is string && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    // ── Messagerie : réservée aux deux participants ─────────
    match /chats/{chatId} {
      // get autorisé si le document n'existe pas encore (test d'existence)
      allow get: if isAuthenticated()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isAuthenticated()
        && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated()
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }
  }
}
